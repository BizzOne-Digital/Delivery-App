# ---------------------------------------------------------------------------
# Delivery App — backend environment
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------
PORT=5000
NODE_ENV=development

# --- MongoDB Atlas ----------------------------------------------------------
# Paste your ROTATED Atlas connection string here (in .env, not in this file).
# The database name MUST be `delivery-app`. Example shape:
#   mongodb+srv://<user>:<password>@<cluster>.xxxxx.mongodb.net/delivery-app?retryWrites=true&w=majority&appName=<app>
# If your password contains @ : / ? # [ ] % it MUST be percent-encoded
# (# -> %23, @ -> %40). An unquoted '#' would also be read as a comment here.
MONGODB_URI=<PASTE_ROTATED_MONGODB_ATLAS_URI_HERE>
MONGODB_DB_NAME=delivery-app

# --- JWT --------------------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=<strong-random-secret>
JWT_REFRESH_SECRET=<strong-random-secret>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- CORS / clients ---------------------------------------------------------
# Comma-separated list is supported for multiple origins.
CLIENT_URL=http://localhost:8081,http://localhost:19006

# --- Uploads ----------------------------------------------------------------
# Public base URL used to build absolute file URLs for proof-of-delivery images.
UPLOAD_BASE_URL=http://localhost:5000
# `local` (disk, dev only) | `memory` (serverless-safe, ephemeral)
STORAGE_DRIVER=local
UPLOAD_MAX_FILE_SIZE_MB=8

# --- Seeding ----------------------------------------------------------------
# Password given to every seeded demo account. Use a throwaway dev password.
# QUOTE the value if it contains '#', '\'' or spaces — an unquoted '#' starts a
# comment and would silently truncate it:  SEED_PASSWORD="MyPa#ssword"
SEED_PASSWORD=<development-password>

# --- Notification adapters (optional) ---------------------------------------
# Leave blank to use the development adapter, which logs non-sensitive
# metadata only and marks every event as `simulated`.
PUSH_PROVIDER=dev
SMS_PROVIDER=dev
EMAIL_PROVIDER=dev

# --- Public patient tracking ------------------------------------------------
# Secret used to sign tokenised, read-only patient tracking links.
TRACKING_TOKEN_SECRET=<strong-random-secret>
TRACKING_TOKEN_TTL_HOURS=48

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=25
